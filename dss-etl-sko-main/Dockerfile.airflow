FROM apache/airflow:2.9.1
USER airflow
RUN pip install --no-cache-dir \
    pandas==2.1.4 \
    numpy==1.26.4 \
    beautifulsoup4==4.12.3 \
    lxml==5.2.2 \
    openpyxl==3.1.2 \
    psycopg2-binary==2.9.9 \
    rapidfuzz==3.14.5 \
    requests==2.32.3 \
    google-api-python-client==2.137.0 \
    google-auth==2.32.0
