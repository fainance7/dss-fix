# Copy to .env at the repo root and adjust as needed: cp configs/.env.example .env

# HTTP server
PORT=8080

# Postgres
DB_URL=postgres://gis:***@127.0.0.1:5432/gis?sslmode=disable
# Schema that migrations operate on (used by `gis migrate fresh`).
DB_SCHEMA=public

# goose CLI (the `gis migrate` subcommand uses DB_URL directly; these are for the
# standalone goose CLI only)
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://gis:***@127.0.0.1:5432/gis?sslmode=disable
GOOSE_MIGRATION_DIR=migrations

# S3 / MinIO — use strong non-default credentials in any shared environment
S3_ENDPOINT=127.0.0.1:9000
S3_ACCESS_KEY=***
S3_SECRET_KEY=***
S3_BUCKET=geofiles
S3_USE_SSL=false

# API authentication — required on all non-health endpoints.
# Set to a long random string (>=32 chars) in production.
# Leave empty only for local development.
API_KEY=

# RabbitMQ
RABBITMQ_URL=amqp://guest:***@127.0.0.1:5672/
RABBITMQ_EXCHANGE=gis.events
RABBITMQ_QUEUE=gis.events.example

# Host port mapping for the postgres container (docker-compose)
DB_PORT=5432

# Landscape Program parallelism (bounds worker peak memory)
LP_MAX_WORKERS=8
LP_MAX_NODES=2
