# BGD GIS — secrets for deployments/docker-compose.yml (audit C-2, L-1).
# Copy to deployments/.env and fill every value. Generate with:
#   openssl rand -hex 32
# docker compose refuses to start while any of these is empty.
API_KEY=
GIS_DB_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
# Local development only — never in a shared/production environment:
# API_AUTH_DISABLED=true
