# Database
POSTGRES_DB=dss_db
POSTGRES_USER=dss_user
POSTGRES_PASSWORD=change…word
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (пароль обязателен на проде, дефолт в compose — только для локальной разработки)
REDIS_PASSWORD=change…ndom
REDIS_URL=redis://:change…ndom@redis:6379/0

# Auth
JWT_SECRET_KEY=change…cret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ЭЦП / NCANode (audit H-1)
# ECP_VERIFY_MODE: "ncanode" — криптопроверка подписи через NCANode (обязательно в production).
#                  "legacy" — только dev/переходный период (запрещён в production, fail-fast).
ECP_VERIFY_MODE=ncanode
NCANODE_URL=http://ncanode:14579
NCANODE_TIMEOUT=15
NCANODE_REVOCATION_CHECK=OCSP
ECP_NONCE_TTL_SECONDS=300

# Internal service URLs
BACKEND_URL=http://backend:8000
AI_SERVICE_URL=http://ai-service:8001
FRONTEND_URL=http://localhost:3000
MARTIN_URL=http://martin:3001

# Подсистема геоданных (смежная команда). Реальный сервис: https://dssgis.dwh.kz
# Для офлайн-разработки можно указать локальный мок http://localhost:8100
# (scripts/gis_mock_service.py — устаревший контракт v1.0.0).
GIS_SERVICE_URL=https://dssgis.dwh.kz
# Ключ X-API-Key для GIS (аудит C-2) — то же значение, что API_KEY у GIS. >=32 символов, обязателен в production.
GIS_API_KEY=

# S3 backup (optional)
S3_BUCKET=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

*** Health monitor (сервис healthmon): период/порог + Telegram-алерты (опционально).
# Без TELEGRAM_* монитор только логирует (docker logs dss-healthmon).
HEALTHMON_INTERVAL=60
HEALTHMON_FAILS=2
TELEGRAM_BOT_TOKEN=
***

# PITR (G14): ретеншн базовых бэкапов и архива WAL (в днях).
# WAL храним ДОЛЬШЕ баз, иначе старейшая база останется без нужного WAL.
PITR_BASE_RETENTION_DAYS=7
PITR_WAL_RETENTION_DAYS=8
