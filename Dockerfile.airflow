# Р-9: образ Airflow обновлён с 2.9.1 до 2.11.2 (последняя ветка 2.x) — уязвимые
# зависимости базового образа (werkzeug, urllib3 и др.) обновлены
FROM apache/airflow:2.11.2
USER airflow
RUN pip install --no-cache-dir \
    pandas==2.1.4 \
    numpy==1.26.4 \
    beautifulsoup4==4.12.3 \
    lxml==6.1.0 \
    openpyxl==3.1.2 \
    psycopg2-binary==2.9.10 \
    rapidfuzz==3.14.5 \
    requests==2.33.0 \
    google-api-python-client==2.137.0
