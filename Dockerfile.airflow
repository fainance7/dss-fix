# Р-9: образ Airflow обновлён с 2.9.1 до 2.11.2 (последняя ветка 2.x).
FROM apache/airflow:2.11.2
USER airflow
RUN pip install --no-cache-dir \
    pandas==2.1.4 \
    numpy==1.26.4 \
    beautifulsoup4==4.12.3 \
    lxml==6.1.0 \
    openpyxl==3.1.2 \
    psycopg2-binary==2.9.10 \
    rapidfuzz==3.14.5 \
    requests==2.33.0 \
    google-api-python-client==2.137.0
# Этап 7 (анализ зависимостей образа): удалены провайдеры и библиотеки, которые DAG
# проекта не используют (облака, сторонние СУБД, мессенджеры, LLM); уязвимые библиотеки
# обновлены до исправленных версий, совместимых с Airflow 2.11.
RUN pip uninstall -y \
      apache-airflow-providers-amazon apache-airflow-providers-cncf-kubernetes \
      apache-airflow-providers-docker apache-airflow-providers-elasticsearch \
      apache-airflow-providers-google apache-airflow-providers-grpc \
      apache-airflow-providers-hashicorp \
      apache-airflow-providers-microsoft-azure apache-airflow-providers-mysql \
      apache-airflow-providers-odbc apache-airflow-providers-openlineage \
      apache-airflow-providers-sendgrid apache-airflow-providers-sftp apache-airflow-providers-slack \
      apache-airflow-providers-snowflake apache-airflow-providers-ssh \
      snowflake-connector-python snowflake-sqlalchemy snowflake-snowpark-python redshift-connector \
      ray litellm asyncssh paramiko pyopenssl uv virtualenv \
      sagemaker-studio aiobotocore gcloud-aio-auth gcloud-aio-storage gcloud-aio-bigquery gcloud-aio-pubsub \
      msal msal-extensions gcsfs sshtunnel adlfs \
    && pip list --format=freeze | grep -iE '^(azure-|microsoft-kiota|msrest|msgraph)' | cut -d= -f1 | xargs -r pip uninstall -y \
    && pip install --no-cache-dir --retries 10 --timeout 60 \
      "apache-airflow==2.11.2" "apache-airflow-providers-ftp>=3.15.1" "apache-airflow-providers-imap" \
      "apache-airflow-providers-smtp>=3.0.0" "aiosmtplib>=5.1.2" \
      "python-docx==1.2.0" "pdfplumber==0.11.9" "xlrd>=2.0.1" \
      "aiohttp>=3.13.4" "anyio>=4.14.2" "authlib>=1.6.11" "certifi>=2026.10.18" "cryptography>=46.0.6" \
      "dnspython>=2.9.2" "ecdsa>=0.19.2" "fsspec>=2026.6.0" "h2>=4.4.1" "hpack>=4.2.0" "httplib2>=0.32.0" \
      "idna>=3.15" "mako>=1.3.12" "msgpack>=1.2.3" "multidict>=6.9.1" "pyasn1>=0.6.4" \
      "pygments>=2.20.0" "pyjwt>=2.12.1" "python-multipart>=0.0.27" "setuptools>=84.1.0" "soupsieve>=2.10.0" \
      "tornado>=6.5.6" "urllib3>=2.8.0" "werkzeug>=3.1.9" "pip>=26.1.2" \
    && pip check
